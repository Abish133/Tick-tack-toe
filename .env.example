# Local Windows setup generates .env and random credentials automatically.
# Set DATABASE_URL yourself only when using an existing external MySQL database.
DATABASE_URL=mysql://elemental_arena:replace_with_random_password@127.0.0.1:3307/elemental_arena
AUTH_SECRET=replace_with_at_least_32_random_bytes
APP_ORIGIN=http://localhost:3000
PORT=3000

# Optional Windows helper settings:
# MYSQL_BASEDIR=C:/Program Files/MySQL/MySQL Server 8.0
# MYSQL_PORT=3307

# Docker Compose uses these from .env.docker instead of the local Windows database:
# MYSQL_ROOT_PASSWORD=replace_with_random_password
# MYSQL_APP_PASSWORD=replace_with_random_password
