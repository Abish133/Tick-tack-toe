# Local Windows setup generates .env and random credentials automatically.
# Set DATABASE_URL yourself only when using an existing external MySQL database.
DATABASE_URL=mysql://elemental_arena:replace_with_random_password@127.0.0.1:3307/elemental_arena
AUTH_SECRET=replace_with_at_least_32_random_bytes
APP_ORIGIN=http://localhost:3000
PORT=3000

# Configure these in Railway service Variables; keep secrets out of Git.
# Razorpay: automatic payment capture required. All prices are INR paise.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_SPARK_PAISE=4900
# RAZORPAY_FLARE_PAISE=9900
# RAZORPAY_COSMIC_PAISE=19900
# RAZORPAY_PASS_PAISE=9900
# Ten matching nine-style collections, each priced at INR149 by default.
# RAZORPAY_COLLECTION_PAISE=14900

# AdMob is available in the Android app, outside Ranked.
ADMOB_REWARDED_AD_UNIT_ID=
# Optional numeric SSV ad unit override (normally inferred from the suffix).
ADMOB_SSV_AD_UNIT_ID=

# Google OAuth Web client. Callback: APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: choose Resend, authenticated SMTP, or an HTTPS delivery webhook.
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE=true for a TLS connection; port465 also enables it.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# The game coordinator requires one replica per database. Persistent matches
# survive handoff; private room codes and matchmaking queues restart.
# COORDINATOR_LOCK_NAMESPACE=elemental-arena

# Optional Windows helper settings:
# MYSQL_BASEDIR=C:/Program Files/MySQL/MySQL Server 8.0
# MYSQL_PORT=3307

# Docker Compose uses these from .env.docker instead of the local Windows database:
# MYSQL_ROOT_PASSWORD=replace_with_random_password
# MYSQL_APP_PASSWORD=replace_with_random_password
